# ==============================================================================
# Muğla Monitör v2 — Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı proje kök dizininde ".env" veya ".env.local" olarak kopyalayıp
# kendi anahtarlarınızı tanımlayın. Gerçek anahtarları repoya eklemeyin.
# ==============================================================================

# Supabase Proje URL'si (Örn: https://proje-ref.supabase.co)
VITE_SUPABASE_URL=

# Supabase İstemci Anon Anahtarı (RLS ile korunur)
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Anahtarı (İsteğe bağlı; yoksa yerel analiz yedeği çalışır)
VITE_GEMINI_API_KEY=

# TomTom Maps / Traffic API Anahtarı (İsteğe bağlı; yoksa ücretsiz altlık kullanılır)
VITE_TOMTOM_API_KEY=

# İstemci arayüzünde gösterilen herkese açık Telegram bülten kanalı bağlantısı
VITE_TELEGRAM_CHANNEL_URL=https://t.me/muglamonitor

# Sunucu taraflı gizli anahtarlar (ASLA VITE_ öneki ile tanımlamayın)
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_SECRET=
CRON_SECRET=