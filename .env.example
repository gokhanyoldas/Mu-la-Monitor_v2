# ==============================================================================
# Muğla Monitör v2 — Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı proje kök dizininde ".env" veya ".env.local" olarak kopyalayıp
# kendi anahtarlarınızı tanımlayın. Gerçek gizli anahtarları (secret) repoya
# eklemeyin.
#
# Production Build Kuralı:
#   `npm run build` sırasında VITE_SUPABASE_URL ve VITE_SUPABASE_ANON_KEY
#   (veya VITE_SUPABASE_PUBLISHABLE_KEY) zorunludur; eksikse build hata verir.
#
# Dağıtım Hedefi (vite.config.ts):
#   - Vercel / Yerel (varsayılan): base = "/"
#   - GitHub Pages: DEPLOY_TARGET=gh-pages (veya GITHUB_PAGES=true) -> base = "/Mu-la-Monitor_v2/"
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend İstemci Değişkenleri (Tarayıcıya Yalnızca Public Anon Key Açılır)
# ------------------------------------------------------------------------------
# Supabase Proje URL'si (Örn: https://proje-ref.supabase.co) — ZORUNLU
VITE_SUPABASE_URL=

# Supabase İstemci Anon / Publishable Anahtarı (RLS ile korunur) — ZORUNLU
VITE_SUPABASE_ANON_KEY=
# Alternatif adlandırma (isteğe bağlı):
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini API Anahtarı (İstemci tarafı metin/olay ayrıştırma için; yoksa yerel NLP çalışır)
VITE_GEMINI_API_KEY=

# TomTom Maps / Traffic API Anahtarı (İstemci harita/trafik katmanı için; yoksa ücretsiz altlık kullanılır)
VITE_TOMTOM_API_KEY=

# Uygulama sürüm, taban URL ve hata izleme ayarları (isteğe bağlı)
VITE_APP_VERSION=2.0.0
VITE_APP_URL=
VITE_SENTRY_DSN=

# ------------------------------------------------------------------------------
# Dağıtım / AI Studio Çalışma Zamanı Değişkenleri
# ------------------------------------------------------------------------------
# GitHub Pages için "gh-pages", Vercel için "vercel" veya boş bırakın ("/")
DEPLOY_TARGET=
GITHUB_PAGES=false

# Google AI Studio çalışma zamanı fallback değişkenleri
GEMINI_API_KEY=
APP_URL=

# ------------------------------------------------------------------------------
# Sunucu / Supabase Edge Functions Secrets (YALNIZCA Supabase Secret Store!)
# Frontend build ortamına veya istemci koduna ASLA eklemeyin.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# İç servis, cron ve worker endpoint doğrulaması için ortak gizli anahtar (min 32 karakter)
INTERNAL_FUNCTION_SECRET=
# İzinli tarayıcı origin listesi (virgülle ayrılmış, örn: https://mugla-monitor.vercel.app,https://gokhanyoldas.github.io)
ALLOWED_ORIGINS=
# Üretimde mock-data-injector davranışı ("production" veya "development")
ENVIRONMENT=production
ALLOW_MOCK_IN_PROD=false

# Harici API Secret'ları (Supabase Edge Functions)
TOMTOM_API_KEY=
FIRECRAWL_API_KEY=
TWITTER_LIVE_ENABLED=0
TWITTER_BEARER_TOKEN=
HUGGINGFACE_API_KEY=

# 7/24 Otonom İstihbarat İşçisi (GitHub Actions: .github/workflows/autonomous-intel-agent.yml)
# İsteğe bağlı: social_keywords tablosu user_id zorunluluğu varsa sistem kullanıcı UUID'si
AGENT_SYSTEM_USER_ID=